{
  "manifest_version": 3,
  "name": "Personal YouTube",
  "version": "0.1.0",
  "description": "Download YouTube videos, shorts and playlists, organise them, play them offline.",
  "minimum_chrome_version": "121",
  "action": { "default_popup": "popup.html", "default_title": "Personal YouTube" },
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["contextMenus", "tabs", "unlimitedStorage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.googlevideo.com/*",
    "*://i.ytimg.com/*",
    "https://app.makewebsmart.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
